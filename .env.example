# Copia este archivo como `.env` y completa los dos valores.
# Los encuentras en el panel de Supabase, en Project Settings → API.

# "Project URL"
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# "anon public" — nunca la llave `service_role`: esa se salta RLS
# y no debe llegar jamás al navegador.
VITE_SUPABASE_ANON_KEY=

# Notificaciones push (spec §6). Genera el par con:
#   npx web-push generate-vapid-keys
# La pública va también en el navegador (por eso el prefijo VITE_); la
# privada NUNCA: solo en las variables de entorno de Vercel.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que el servicio de push puede usar si tu envío da problemas.
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
